{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "paths": {
      "@app/*": ["src/*"],
      "@config/*": ["src/config/*"],
      "@core/*": ["src/core/*"],
      "@common/*": ["src/core/common/*"],
      "@exceptions/*": ["src/core/exceptions/*"],
      "@filters/*": ["src/core/filters/*"],
      "@modules/*": ["src/modules/*"],
      "@env/*": ["src/env/*"],
      "@database/*": ["src/modules/database/*"],
      "@products/*": ["src/modules/products/*"],
      "@users/*": ["src/modules/users/*"],
      "@auth/*": ["src/modules/auth/*"],
      "@jwt/*": ["src/modules/jwt/*"]
    }
  }
}
